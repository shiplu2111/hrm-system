# Production Pre-built NestJS API
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup -S hrm && adduser -S hrm -G hrm

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared-types/package.json packages/shared-types/

# Install build tools for native modules (bcrypt)
RUN apk add --no-cache python3 make g++

# Install only production dependencies
RUN npm ci --workspace=@hrm/api --workspace=@hrm/shared-types --include-workspace-root --omit=dev


COPY apps/api/dist ./apps/api/dist
COPY apps/api/prisma ./apps/api/prisma
COPY packages/shared-types/dist ./packages/shared-types/dist

WORKDIR /app/apps/api
RUN npx prisma generate

WORKDIR /app
RUN mkdir -p /app/storage && chown -R hrm:hrm /app
USER hrm
EXPOSE 3000

CMD ["node", "apps/api/dist/main.js"]
