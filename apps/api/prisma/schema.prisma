  milestoneId     String?                 @map("milestone_id") @db.Uuid
  invoiceNumber   String                  @map("invoice_number")
  periodLabel     String?                 @map("period_label")
  description     String?                 @db.Text
  lineItems       Json                    @default("[]") @map("line_items")
  hoursWorked     Decimal?                @map("hours_worked") @db.Decimal(10, 2)
  hourlyRate      Decimal?                @map("hourly_rate") @db.Decimal(14, 2)
  amount          Decimal                 @db.Decimal(14, 2)
  currency        String                  @default("AUD") @db.VarChar(3)
  issuedAt        DateTime                @map("issued_at")
  dueAt           DateTime                @map("due_at")
  status          ContractorInvoiceStatus @default(draft)
  paidAt          DateTime?               @map("paid_at")
  paymentReference String?                @map("payment_reference")
  approvedByUserId String?                @map("approved_by_user_id") @db.Uuid
  createdByUserId String                  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contractor Contractor         @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  contract   ContractorContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  milestone  ContractorContractMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  paymentBatchItem ContractorPaymentBatchItem?

  @@unique([companyId, invoiceNumber])
  @@index([tenantId])
  @@index([companyId, status])
  @@index([contractorId])
  @@index([contractId])
  @@index([milestoneId])
  @@index([companyId, dueAt])
  @@map("contractor_invoices")
}

/// Contractor payment batch — separate from employee payment_batches / payroll_periods.
model ContractorPaymentBatch {
  id                   String                       @id @default(uuid()) @db.Uuid
  tenantId             String                       @map("tenant_id") @db.Uuid
  companyId            String                       @map("company_id") @db.Uuid
  referenceNumber      String                       @map("reference_number")
  status               ContractorPaymentBatchStatus @default(draft)
  totalAmount          Decimal                      @map("total_amount") @db.Decimal(14, 2)
  currency             String                       @default("AUD") @db.VarChar(3)
  itemCount            Int                          @map("item_count")
  transactionReference String?                      @map("transaction_reference")
  failureReason        String?                      @map("failure_reason")
  submittedAt          DateTime?                    @map("submitted_at")
  paidAt               DateTime?                    @map("paid_at")
  failedAt             DateTime?                    @map("failed_at")
  createdByUserId      String                       @map("created_by_user_id") @db.Uuid
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  tenant        Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items         ContractorPaymentBatchItem[]
  journalExport ContractorJournalExport?

  @@unique([companyId, referenceNumber])
  @@index([tenantId])
  @@index([companyId, status])
  @@map("contractor_payment_batches")
}

model ContractorPaymentBatchItem {
  id                   String                           @id @default(uuid()) @db.Uuid
  tenantId             String                           @map("tenant_id") @db.Uuid
  paymentBatchId       String                           @map("payment_batch_id") @db.Uuid
  contractorInvoiceId  String                           @unique @map("contractor_invoice_id") @db.Uuid
  contractorId         String                           @map("contractor_id") @db.Uuid
  amount               Decimal                          @db.Decimal(14, 2)
  status               ContractorPaymentBatchItemStatus @default(pending)
  transactionReference String?                          @map("transaction_reference")
  failureReason        String?                          @map("failure_reason")
  createdAt            DateTime                         @default(now()) @map("created_at")
  updatedAt            DateTime                         @updatedAt @map("updated_at")

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  paymentBatch      ContractorPaymentBatch @relation(fields: [paymentBatchId], references: [id], onDelete: Restrict)
  contractorInvoice ContractorInvoice      @relation(fields: [contractorInvoiceId], references: [id], onDelete: Restrict)
  contractor        Contractor             @relation(fields: [contractorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([paymentBatchId])
  @@index([contractorId])
  @@index([status])
  @@map("contractor_payment_batch_items")
}

// ---------------------------------------------------------------------------
// §8i Multi-Currency Payroll (MODULES.md §46, RULES.md §4)
// ---------------------------------------------------------------------------

/// Tenant-scoped FX rates — effective-dated; payroll locks the rate active on period end date.
model ExchangeRate {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  baseCurrency  String    @map("base_currency") @db.VarChar(3)
  quoteCurrency String    @map("quote_currency") @db.VarChar(3)
  /// Base currency units received for 1 unit of quote currency (e.g. 1 USD → 1.48 AUD).
  rate          Decimal   @db.Decimal(18, 8)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdByUserId String  @map("created_by_user_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payrollRuns PayrollRun[]

  @@index([tenantId, baseCurrency, quoteCurrency, effectiveFrom])
  @@map("exchange_rates")
}

// ---------------------------------------------------------------------------
// §9 Audit & Security (DATABASE_SCHEMA.md, AUDIT_LOG.md)
// ---------------------------------------------------------------------------

enum AuditAction {
  create
  update
  delete
  approve
  finalize
  reject
  suspend
  restore

  @@map("audit_action")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String?     @map("tenant_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  action    AuditAction
  module    String
  recordId  String      @map("record_id") @db.Uuid
  oldValue  Json?       @map("old_value")
  newValue  Json?       @map("new_value")
  ipAddress String?     @map("ip_address")
  device    String?
  createdAt DateTime    @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, module])
  @@index([tenantId, recordId])
  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions Permission[]
  users       User[]

  @@index([tenantId])
  @@map("roles")
}

enum PermissionAction {
  view
  create
  edit
  delete
  approve
  finalize

  @@map("permission_action")
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  module    String
  action    PermissionAction
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([roleId, module, action])
  @@index([roleId])
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// Auth (AUTH_FLOW.md §1–§3)
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String?   @map("tenant_id") @db.Uuid
  employeeId          String?   @unique @map("employee_id") @db.Uuid
  roleId              String    @map("role_id") @db.Uuid
  email               String
  passwordHash        String    @map("password_hash")
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee      Employee?      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]
  inAppNotifications InAppNotification[]
  pushDeviceTokens PushDeviceToken[]
  completedInterviewRounds JobApplicationInterviewRound[] @relation("InterviewCompletedBy")

  @@index([tenantId])
  @@index([roleId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Notifications (NOTIFICATION_LOGIC.md §1–§6)
// ---------------------------------------------------------------------------

enum NotificationChannelType {
  in_app
  email
  push

  @@map("notification_channel_type")
}

enum PushPlatform {
  ios
  android

  @@map("push_platform")
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed

  @@map("notification_delivery_status")
}

model InAppNotification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  eventType String    @map("event_type")
  title     String
  body      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([userId, readAt])
  @@index([tenantId, userId, createdAt])
  @@map("in_app_notifications")
}

model NotificationDelivery {
  id              String                     @id @default(uuid()) @db.Uuid
  tenantId        String                     @map("tenant_id") @db.Uuid
  companyId       String                     @map("company_id") @db.Uuid
  eventType       String                     @map("event_type")
  channel         NotificationChannelType
  recipientUserId String?                    @map("recipient_user_id") @db.Uuid
  recipientEmail  String?                    @map("recipient_email")
  recipientPushToken String?                 @map("recipient_push_token")
  status          NotificationDeliveryStatus @default(pending)
  attemptCount    Int                        @default(0) @map("attempt_count")
  lastError       String?                    @map("last_error")
  payload         Json                       @default("{}")
  sentAt          DateTime?                  @map("sent_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, eventType])
  @@map("notification_deliveries")
}

model PushDeviceToken {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  deviceId   String       @map("device_id")
  token      String
  platform   PushPlatform
  lastSeenAt DateTime     @default(now()) @map("last_seen_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([tenantId])
  @@index([userId])
  @@map("push_device_tokens")
}

// ---------------------------------------------------------------------------
// §11 Runtime Settings (DATABASE_SCHEMA.md, SYSTEM_SETTINGS.md §2a)
// ---------------------------------------------------------------------------

enum TenantSettingCategory {
  smtp
  notification
  integration
  branding
  feature_flag

  @@map("tenant_setting_category")
}

enum PlatformSettingCategory {
  smtp_default
  notification_default
  country_config
  maintenance

  @@map("platform_setting_category")
}

model TenantSetting {
  id        String                @id @default(uuid()) @db.Uuid
  tenantId  String                @map("tenant_id") @db.Uuid
  category  TenantSettingCategory
  key       String
  value     Json
  updatedBy String                @map("updated_by") @db.Uuid
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, category, key])
  @@index([tenantId])
  @@index([tenantId, category])
  @@map("tenant_settings")
}

model PlatformSetting {
  id        String                  @id @default(uuid()) @db.Uuid
  category  PlatformSettingCategory
  key       String
  value     Json
  updatedBy String                  @map("updated_by") @db.Uuid
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  @@unique([category, key])
  @@map("platform_settings")
}
