model PayrollAdjustment {
  id                     String                  @id @default(uuid()) @db.Uuid
  companyId              String                  @map("company_id") @db.Uuid
  employeeId             String                  @map("employee_id") @db.Uuid
  originalPayrollRunId   String                  @map("original_payroll_run_id") @db.Uuid
  applyToPayrollPeriodId String?                 @map("apply_to_payroll_period_id") @db.Uuid
  retroactiveFrom        DateTime                @map("retroactive_from") @db.Date
  retroactiveTo          DateTime                @map("retroactive_to") @db.Date
  reason                 String
  originalGrossPay       Decimal                 @map("original_gross_pay") @db.Decimal(14, 2)
  originalTotalDeductions Decimal                @map("original_total_deductions") @db.Decimal(14, 2)
  originalNetPay         Decimal                 @map("original_net_pay") @db.Decimal(14, 2)
  revisedGrossPay        Decimal                 @map("revised_gross_pay") @db.Decimal(14, 2)
  revisedTotalDeductions Decimal                 @map("revised_total_deductions") @db.Decimal(14, 2)
  revisedNetPay          Decimal                 @map("revised_net_pay") @db.Decimal(14, 2)
  adjustmentGrossPay     Decimal                 @map("adjustment_gross_pay") @db.Decimal(14, 2)
  adjustmentTotalDeductions Decimal              @map("adjustment_total_deductions") @db.Decimal(14, 2)
  adjustmentNetPay       Decimal                 @map("adjustment_net_pay") @db.Decimal(14, 2)
