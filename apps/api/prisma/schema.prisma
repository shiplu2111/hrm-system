/// Workplace incident report — submittable by any employee (incl. mobile field workers).
model WorkplaceIncident {
  id                       String                    @id @default(uuid()) @db.Uuid
  tenantId                 String                    @map("tenant_id") @db.Uuid
  companyId                String                    @map("company_id") @db.Uuid
  incidentNumber           String                    @map("incident_number")
  incidentType             WorkplaceIncidentType     @map("incident_type")
  severity                 WorkplaceIncidentSeverity
  status                   WorkplaceIncidentStatus   @default(reported)
  location                 String
  occurredAt               DateTime                  @map("occurred_at")
  description              String                    @db.Text
  reportedByEmployeeId     String                    @map("reported_by_employee_id") @db.Uuid
  gpsLat                   Decimal?                  @map("gps_lat") @db.Decimal(10, 7)
  gpsLng                   Decimal?                  @map("gps_lng") @db.Decimal(10, 7)
  regulatorReportRequired  Boolean                   @default(false) @map("regulator_report_required")
  regulatorReportDueAt     DateTime?                 @map("regulator_report_due_at")
  regulatorReportSubmittedAt DateTime?               @map("regulator_report_submitted_at")
  regulatorName            String?                   @map("regulator_name")
  investigationNotes       String?                   @map("investigation_notes") @db.Text
  resolvedAt               DateTime?                 @map("resolved_at")
  createdByUserId          String                    @map("created_by_user_id") @db.Uuid
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reportedByEmployee Employee                @relation("IncidentReporter", fields: [reportedByEmployeeId], references: [id], onDelete: Restrict)
  parties          WorkplaceIncidentParty[]
  injuryEntries    InjuryLogEntry[]

  @@unique([companyId, incidentNumber])
  @@index([tenantId])
  @@index([companyId, status])
  @@index([companyId, occurredAt])
  @@index([reportedByEmployeeId])
  @@map("workplace_incidents")
}

model WorkplaceIncidentParty {
  id         String            @id @default(uuid()) @db.Uuid
