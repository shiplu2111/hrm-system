  @@index([tenantId])
  @@index([enrollmentId])
  @@map("benefit_enrollment_dependents")
}

// ---------------------------------------------------------------------------
// §8b Accounting / GL Integration (MODULES.md §36, THIRD_PARTY_INTEGRATIONS.md §3)
// ---------------------------------------------------------------------------

enum GlAccountType {
  asset
  liability
  equity
  revenue
  expense

  @@map("gl_account_type")
}

enum GlMappingPostingSide {
  debit
  credit

  @@map("gl_mapping_posting_side")
}

enum PayrollJournalExportStatus {
  pending
  completed
  failed

  @@map("payroll_journal_export_status")
}

enum AccountingProvider {
  xero
  quickbooks
  tally

  @@map("accounting_provider")
}

enum AccountingConnectionStatus {
  connected
  disconnected
  error
  token_expired

  @@map("accounting_connection_status")
}

enum AccountingSyncJobStatus {
  queued
  processing
  completed
  failed

  @@map("accounting_sync_job_status")
}

model GlAccount {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  code        String
  name        String
  accountType GlAccountType @map("account_type")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payrollMappings  GlPayrollMapping[]

  @@unique([companyId, code])
  @@index([tenantId])
  @@index([companyId])
  @@map("gl_accounts")
}

model GlPayrollMapping {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  companyId      String               @map("company_id") @db.Uuid
  payComponentId String?              @map("pay_component_id") @db.Uuid
  systemKey      String?              @map("system_key")
  postingSide    GlMappingPostingSide @map("posting_side")
  glAccountId    String               @map("gl_account_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payComponent PayComponent? @relation(fields: [payComponentId], references: [id], onDelete: Cascade)
  glAccount    GlAccount    @relation(fields: [glAccountId], references: [id], onDelete: Restrict)

  @@unique([companyId, payComponentId])
  @@unique([companyId, systemKey])
  @@index([tenantId])
  @@index([companyId])
  @@index([glAccountId])
  @@map("gl_payroll_mappings")
}

model PayrollJournalExport {
  id              String                     @id @default(uuid()) @db.Uuid
  tenantId        String                     @map("tenant_id") @db.Uuid
  companyId       String                     @map("company_id") @db.Uuid
  payrollPeriodId String                     @map("payroll_period_id") @db.Uuid
  referenceNumber String                     @map("reference_number")
  status          PayrollJournalExportStatus @default(pending)
  provider        AccountingProvider?        @map("provider")
  journalData     Json                       @map("journal_data")
  totalDebit      Decimal                    @map("total_debit") @db.Decimal(14, 2)
  totalCredit     Decimal                    @map("total_credit") @db.Decimal(14, 2)
  unmappedCount   Int                        @default(0) @map("unmapped_count")
  errorMessage    String?                    @map("error_message")
  externalReferenceId String?                @map("external_reference_id")
  exportedByUserId String?                   @map("exported_by_user_id") @db.Uuid
  exportedAt      DateTime?                  @map("exported_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  syncJobs      AccountingSyncJob[]

  @@index([tenantId])
  @@index([companyId])
  @@index([payrollPeriodId])
  @@index([status])
  @@map("payroll_journal_exports")
}

model AccountingConnection {
  id                    String                     @id @default(uuid()) @db.Uuid
  tenantId              String                     @map("tenant_id") @db.Uuid
  companyId             String                     @map("company_id") @db.Uuid
  provider              AccountingProvider
  status                AccountingConnectionStatus @default(disconnected)
  externalTenantId      String?                    @map("external_tenant_id")
  externalOrgName       String?                    @map("external_org_name")
  accessTokenEncrypted  String?                    @map("access_token_encrypted")
  refreshTokenEncrypted String?                    @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?                  @map("token_expires_at")
  scopes                String?
  lastSyncAt            DateTime?                  @map("last_sync_at")
  lastSyncStatus        AccountingSyncJobStatus?   @map("last_sync_status")
  lastSyncError         String?                    @map("last_sync_error")
  connectedByUserId     String?                    @map("connected_by_user_id") @db.Uuid
  connectedAt           DateTime?                  @map("connected_at")
  disconnectedAt        DateTime?                  @map("disconnected_at")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company  Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  syncJobs AccountingSyncJob[]

  @@unique([companyId, provider])
  @@index([tenantId])
  @@index([companyId])
  @@index([status])
  @@map("accounting_connections")
}

model AccountingOAuthState {
  id         String             @id @default(uuid()) @db.Uuid
  stateToken String             @unique @map("state_token")
  tenantId   String             @map("tenant_id") @db.Uuid
  companyId  String             @map("company_id") @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  provider   AccountingProvider
  expiresAt  DateTime           @map("expires_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("accounting_oauth_states")
}

model AccountingSyncJob {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @map("tenant_id") @db.Uuid
  companyId              String                  @map("company_id") @db.Uuid
  payrollPeriodId        String                  @map("payroll_period_id") @db.Uuid
  provider               AccountingProvider      @default(xero)
  accountingConnectionId String?                 @map("accounting_connection_id") @db.Uuid
  payrollJournalExportId String?                 @map("payroll_journal_export_id") @db.Uuid
  status                 AccountingSyncJobStatus @default(queued)
  bullJobId              String?                 @map("bull_job_id")
  attempts               Int                     @default(0)
  errorMessage           String?                 @map("error_message")
  externalJournalId      String?                 @map("external_journal_id")
  queuedAt               DateTime                @default(now()) @map("queued_at")
  startedAt              DateTime?               @map("started_at")
  completedAt            DateTime?               @map("completed_at")
  failedAt               DateTime?               @map("failed_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payrollPeriod        PayrollPeriod         @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  accountingConnection AccountingConnection? @relation(fields: [accountingConnectionId], references: [id], onDelete: SetNull)
  payrollJournalExport PayrollJournalExport? @relation(fields: [payrollJournalExportId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([companyId, status])
  @@index([payrollPeriodId, provider])
  @@map("accounting_sync_jobs")
}

// ---------------------------------------------------------------------------
// §9 Audit & Security (DATABASE_SCHEMA.md, AUDIT_LOG.md)
// ---------------------------------------------------------------------------

enum AuditAction {
  create
  update
  delete
  approve
  finalize
  reject
  suspend
  restore

  @@map("audit_action")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String?     @map("tenant_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  action    AuditAction
  module    String
  recordId  String      @map("record_id") @db.Uuid
  oldValue  Json?       @map("old_value")
  newValue  Json?       @map("new_value")
  ipAddress String?     @map("ip_address")
  device    String?
  createdAt DateTime    @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, module])
  @@index([tenantId, recordId])
  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions Permission[]
  users       User[]

  @@index([tenantId])
  @@map("roles")
}

enum PermissionAction {
  view
  create
  edit
  delete
  approve
  finalize

  @@map("permission_action")
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  module    String
  action    PermissionAction
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([roleId, module, action])
  @@index([roleId])
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// Auth (AUTH_FLOW.md §1–§3)
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String?   @map("tenant_id") @db.Uuid
  employeeId          String?   @unique @map("employee_id") @db.Uuid
  roleId              String    @map("role_id") @db.Uuid
  email               String
  passwordHash        String    @map("password_hash")
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee      Employee?      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]
  inAppNotifications InAppNotification[]
  pushDeviceTokens PushDeviceToken[]
  completedInterviewRounds JobApplicationInterviewRound[] @relation("InterviewCompletedBy")

  @@index([tenantId])
  @@index([roleId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Notifications (NOTIFICATION_LOGIC.md §1–§6)
// ---------------------------------------------------------------------------

enum NotificationChannelType {
  in_app
  email
  push

  @@map("notification_channel_type")
}

enum PushPlatform {
  ios
  android

  @@map("push_platform")
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed

  @@map("notification_delivery_status")
}

model InAppNotification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  eventType String    @map("event_type")
  title     String
  body      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([userId, readAt])
  @@index([tenantId, userId, createdAt])
  @@map("in_app_notifications")
}

model NotificationDelivery {
  id              String                     @id @default(uuid()) @db.Uuid
  tenantId        String                     @map("tenant_id") @db.Uuid
  companyId       String                     @map("company_id") @db.Uuid
  eventType       String                     @map("event_type")
  channel         NotificationChannelType
  recipientUserId String?                    @map("recipient_user_id") @db.Uuid
  recipientEmail  String?                    @map("recipient_email")
  recipientPushToken String?                 @map("recipient_push_token")
  status          NotificationDeliveryStatus @default(pending)
  attemptCount    Int                        @default(0) @map("attempt_count")
  lastError       String?                    @map("last_error")
  payload         Json                       @default("{}")
  sentAt          DateTime?                  @map("sent_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, eventType])
  @@map("notification_deliveries")
}

model PushDeviceToken {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  deviceId   String       @map("device_id")
  token      String
  platform   PushPlatform
  lastSeenAt DateTime     @default(now()) @map("last_seen_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([tenantId])
  @@index([userId])
  @@map("push_device_tokens")
}

// ---------------------------------------------------------------------------
// §11 Runtime Settings (DATABASE_SCHEMA.md, SYSTEM_SETTINGS.md §2a)
// ---------------------------------------------------------------------------

enum TenantSettingCategory {
  smtp
  notification
  integration
  branding
  feature_flag

  @@map("tenant_setting_category")
}

enum PlatformSettingCategory {
  smtp_default
  notification_default
  country_config
  maintenance

  @@map("platform_setting_category")
}

model TenantSetting {
  id        String                @id @default(uuid()) @db.Uuid
  tenantId  String                @map("tenant_id") @db.Uuid
  category  TenantSettingCategory
  key       String
  value     Json
  updatedBy String                @map("updated_by") @db.Uuid
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, category, key])
  @@index([tenantId])
  @@index([tenantId, category])
  @@map("tenant_settings")
}

model PlatformSetting {
  id        String                  @id @default(uuid()) @db.Uuid
  category  PlatformSettingCategory
  key       String
  value     Json
  updatedBy String                  @map("updated_by") @db.Uuid
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  @@unique([category, key])
  @@map("platform_settings")
}
