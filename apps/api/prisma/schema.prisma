generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// §1 Core Multi-Tenancy & Country Framework (DATABASE_SCHEMA.md)
// ---------------------------------------------------------------------------

enum TenantStatus {
  active
  suspended
  cancelled

  @@map("tenant_status")
}

enum StorageDriver {
  local
  s3

  @@map("storage_driver")
}

enum CountryRuleType {
  tax
  leave
  ot
  social_security
  public_holiday
  health_safety

  @@map("country_rule_type")
}

model Tenant {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  subdomain     String        @unique
  planId        String?       @map("plan_id")
  status        TenantStatus  @default(active)
  storageDriver StorageDriver @default(local) @map("storage_driver")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  companies Company[]
  employees Employee[]
  auditLogs AuditLog[]
  roles     Role[]
  tenantSettings TenantSetting[]
  users     User[]
  inAppNotifications InAppNotification[]
  notificationDeliveries NotificationDelivery[]
  pushDeviceTokens PushDeviceToken[]
  companyRules CompanyRule[]
  employeeContractRules EmployeeContractRule[]
  workflowInstances     WorkflowInstance[]
  employmentContracts   EmploymentContract[]
  employmentContractDocuments EmploymentContractDocument[]
  employeeLoans               EmployeeLoan[]
  loanInstallments            LoanInstallment[]
  expenseCategories           ExpenseCategory[]
  expenseClaims               ExpenseClaim[]
  expenseClaimReceipts        ExpenseClaimReceipt[]
  timesheetProjects           TimesheetProject[]
  timesheetEntries            TimesheetEntry[]
  jobRequisitions             JobRequisition[]
  jobPostings                 JobPosting[]
  candidates                  Candidate[]
  jobApplications             JobApplication[]
  jobApplicationResumes       JobApplicationResume[]
  jobApplicationInterviewRounds JobApplicationInterviewRound[]
  offerLetters                OfferLetter[]
  onboardingChecklistTemplates OnboardingChecklistTemplate[]
  employeeOnboardings         EmployeeOnboarding[]
  companyAssets               CompanyAsset[]
  offboardingChecklistTemplates OffboardingChecklistTemplate[]
  employeeOffboardings        EmployeeOffboarding[]
  benefitPlans                BenefitPlan[]
  benefitOpenEnrollmentPeriods BenefitOpenEnrollmentPeriod[]
  benefitEnrollments          BenefitEnrollment[]
  benefitEnrollmentDependents BenefitEnrollmentDependent[]
  glAccounts                  GlAccount[]
  glPayrollMappings           GlPayrollMapping[]
  glContractorMappings        GlContractorMapping[]
  payrollJournalExports       PayrollJournalExport[]
  contractorJournalExports    ContractorJournalExport[]
  accountingConnections       AccountingConnection[]
  accountingSyncJobs          AccountingSyncJob[]
  tenantApiKeys               TenantApiKey[]
  tenantOAuthClients          TenantOAuthClient[]
  tenantOAuthAccessTokens     TenantOAuthAccessToken[]
  tenantWebhooks              TenantWebhook[]
  webhookDeliveries           WebhookDelivery[]
  kbCategories                KbCategory[]
  kbArticles                  KbArticle[]
  supportTickets              SupportTicket[]
  supportTicketMessages       SupportTicketMessage[]
  exchangeRates               ExchangeRate[]
  holidays                    Holiday[]
  performanceReviewCycles     PerformanceReviewCycle[]
  kpiDefinitions              KpiDefinition[]
  employeeKpiAssignments      EmployeeKpiAssignment[]
  performanceReviewParticipants PerformanceReviewParticipant[]
  employeePerformanceReviews  EmployeePerformanceReview[]
  performance360Feedbacks     Performance360Feedback[]
  trainingCourses             TrainingCourse[]
  trainingSessions            TrainingSession[]
  trainingSessionCosts        TrainingSessionCost[]
  trainingAttendances         TrainingAttendance[]
  skills                      Skill[]
  employeeSkills              EmployeeSkill[]
  employeeCertifications      EmployeeCertification[]
  hrCases                     HrCase[]
  hrCaseNotes                 HrCaseNote[]
  hrCaseParties               HrCaseParty[]
  hrCaseDisciplinaryActions   HrCaseDisciplinaryAction[]
  hrCaseInvestigationRecords  HrCaseInvestigationRecord[]
  companyAnnouncements        CompanyAnnouncement[]
  engagementSurveys           EngagementSurvey[]
  engagementSurveyResponses   EngagementSurveyResponse[]
  employeeKudos               EmployeeKudos[]
  workplaceIncidents          WorkplaceIncident[]
  workplaceIncidentParties    WorkplaceIncidentParty[]
  injuryLogEntries            InjuryLogEntry[]
  safetyComplianceRecords     SafetyComplianceRecord[]
  safetyInspections           SafetyInspection[]
  contractors                 Contractor[]
  contractorContracts         ContractorContract[]
  contractorInvoices          ContractorInvoice[]
  contractorPaymentBatches    ContractorPaymentBatch[]
  contractorPaymentBatchItems ContractorPaymentBatchItem[]
  contractorContractMilestones ContractorContractMilestone[]

  @@map("tenants")
}

model Country {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  isoCode      String   @unique @map("iso_code") @db.VarChar(3)
  currency     String   @db.VarChar(3)
  timezone     String
  dateFormat   String   @map("date_format")
  numberFormat String   @default("1,234.56") @map("number_format")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  countryRules CountryRule[]
  companies    Company[]
  payrollRules PayrollRule[]
  taxBrackets  TaxBracket[]
  stateProvinceRules StateProvinceRule[]

  @@map("countries")
}

model CountryRule {
  id            String          @id @default(uuid()) @db.Uuid
  countryId     String          @map("country_id") @db.Uuid
  ruleType      CountryRuleType @map("rule_type")
  payload       Json
  effectiveFrom DateTime        @map("effective_from") @db.Date
  effectiveTo   DateTime?       @map("effective_to") @db.Date
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@index([countryId])
  @@index([countryId, ruleType, effectiveFrom])
  @@map("country_rules")
}

model GlobalRule {
  id            String    @id @default(uuid()) @db.Uuid
  ruleType      String    @map("rule_type")
  payload       Json
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([ruleType, effectiveFrom])
  @@map("global_rules")
}

model StateProvinceRule {
  id            String    @id @default(uuid()) @db.Uuid
  countryId     String    @map("country_id") @db.Uuid
  stateCode     String    @map("state_code") @db.VarChar(16)
  ruleType      String    @map("rule_type")
  payload       Json
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@index([countryId])
  @@index([countryId, stateCode, ruleType, effectiveFrom])
  @@map("state_province_rules")
}

model CompanyRule {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  ruleType      String    @map("rule_type")
  payload       Json
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([companyId])
  @@index([tenantId, companyId, ruleType, effectiveFrom])
  @@map("company_rules")
}

model EmployeeContractRule {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  ruleType      String    @map("rule_type")
  payload       Json
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([employeeId])
  @@index([tenantId, employeeId, ruleType, effectiveFrom])
  @@map("employee_contract_rules")
}

model Company {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  name              String
  countryId         String   @map("country_id") @db.Uuid
  financialYearStart Int     @map("financial_year_start") @db.SmallInt
  payrollBaseCurrency String? @map("payroll_base_currency") @db.VarChar(3)
  timezone          String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  country   Country    @relation(fields: [countryId], references: [id], onDelete: Restrict)
  locations       Location[]
  departments     Department[]
  jobLevels       JobLevel[]
  designations    Designation[]
  employmentTypes EmploymentType[]
  teams           Team[]
  costCentres     CostCentre[]
  employees       Employee[]
  payComponents   PayComponent[]
  payrollRules    PayrollRule[]
  shifts          Shift[]
  leaveTypes      LeaveType[]
  leavePolicies   LeavePolicy[]
  payrollPeriods  PayrollPeriod[]
  payrollAdjustments PayrollAdjustment[]
  paymentBatches  PaymentBatch[]
  companyRules    CompanyRule[]
  documentTypes   DocumentType[]
  customFieldDefinitions CustomFieldDefinition[]
  holidays        Holiday[]
  workflowDefinitions WorkflowDefinition[]
  workflowInstances   WorkflowInstance[]
  employmentContracts EmploymentContract[]
  employeeLoans       EmployeeLoan[]
  expenseCategories   ExpenseCategory[]
  expenseClaims       ExpenseClaim[]
  timesheetProjects   TimesheetProject[]
  timesheetEntries    TimesheetEntry[]
  jobRequisitions     JobRequisition[]
  jobPostings         JobPosting[]
  candidates          Candidate[]
  jobApplications     JobApplication[]
  jobApplicationInterviewRounds JobApplicationInterviewRound[]
  offerLetters                OfferLetter[]
  onboardingChecklistTemplates OnboardingChecklistTemplate[]
  employeeOnboardings         EmployeeOnboarding[]
  companyAssets               CompanyAsset[]
  offboardingChecklistTemplates OffboardingChecklistTemplate[]
  employeeOffboardings        EmployeeOffboarding[]
  benefitPlans                BenefitPlan[]
  benefitOpenEnrollmentPeriods BenefitOpenEnrollmentPeriod[]
  benefitEnrollments          BenefitEnrollment[]
  glAccounts                  GlAccount[]
  glPayrollMappings           GlPayrollMapping[]
  glContractorMappings        GlContractorMapping[]
  payrollJournalExports       PayrollJournalExport[]
  accountingConnections       AccountingConnection[]
  accountingSyncJobs          AccountingSyncJob[]
  performanceReviewCycles     PerformanceReviewCycle[]
  kpiDefinitions              KpiDefinition[]
  employeeKpiAssignments      EmployeeKpiAssignment[]
  performanceReviewParticipants PerformanceReviewParticipant[]
  employeePerformanceReviews    EmployeePerformanceReview[]
  performance360Feedbacks       Performance360Feedback[]
  trainingCourses               TrainingCourse[]
  trainingSessions              TrainingSession[]
  trainingSessionCosts          TrainingSessionCost[]
  trainingAttendances           TrainingAttendance[]
  skills                        Skill[]
  employeeSkills                EmployeeSkill[]
  employeeCertifications        EmployeeCertification[]
  hrCases                       HrCase[]
  hrCaseDisciplinaryActions     HrCaseDisciplinaryAction[]
  companyAnnouncements          CompanyAnnouncement[]
  engagementSurveys             EngagementSurvey[]
  employeeKudos                 EmployeeKudos[]
  workplaceIncidents            WorkplaceIncident[]
  injuryLogEntries              InjuryLogEntry[]
  safetyComplianceRecords       SafetyComplianceRecord[]
  safetyInspections             SafetyInspection[]
  contractors                   Contractor[]
  contractorContracts           ContractorContract[]
  contractorInvoices            ContractorInvoice[]
  contractorPaymentBatches      ContractorPaymentBatch[]
  contractorContractMilestones  ContractorContractMilestone[]
  contractorJournalExports      ContractorJournalExport[]

  @@index([tenantId])
  @@index([countryId])
  @@map("companies")
}

model Location {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  name             String
  address          String?
  timezone         String?
  lat              Decimal? @db.Decimal(10, 7)
  lng              Decimal? @db.Decimal(10, 7)
  geofenceRadiusM  Int?     @map("geofence_radius_m")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees Employee[] @relation("EmployeeWorkLocation")
  rosters   Roster[]
  holidays  Holiday[]
  jobRequisitions JobRequisition[]
  offerLetters    OfferLetter[]

  @@index([companyId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// §2 Organization (DATABASE_SCHEMA.md)
// ---------------------------------------------------------------------------

model Department {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  parentDepartmentId String?  @map("parent_department_id") @db.Uuid
  name               String
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company            Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: Restrict)
  childDepartments   Department[] @relation("DepartmentHierarchy")
  designations       Designation[]
  employees          Employee[]
  jobRequisitions    JobRequisition[]
  offerLetters       OfferLetter[]

  @@index([companyId])
  @@index([parentDepartmentId])
  @@map("departments")
}

model JobLevel {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  rank      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  designations Designation[]
  jobRequisitions JobRequisition[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("job_levels")
}

model Designation {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  jobLevelId   String?  @map("job_level_id") @db.Uuid
  name         String
  salaryGrade  String?  @map("salary_grade")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobLevel   JobLevel?   @relation(fields: [jobLevelId], references: [id], onDelete: Restrict)
  employees  Employee[]
  jobRequisitions JobRequisition[]
  offerLetters    OfferLetter[]
  performanceReviewRecommendations EmployeePerformanceReview[]

  @@index([companyId])
  @@index([departmentId])
  @@index([jobLevelId])
  @@map("designations")
}

model EmploymentType {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees Employee[]
  jobRequisitions JobRequisition[]
  offerLetters    OfferLetter[]

  @@index([companyId])
  @@map("employment_types")
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("teams")
}

model CostCentre {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  code      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees Employee[] @relation("EmployeeCostCentre")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("cost_centres")
}

// ---------------------------------------------------------------------------
// §3 Employee (DATABASE_SCHEMA.md)
// ---------------------------------------------------------------------------

enum EmploymentStatus {
  active
  inactive
  terminated
  on_leave

  @@map("employment_status")
}

enum LifecycleEventType {
  promotion
  transfer
  salary_revision
  probation
  confirmation
  suspension
  resignation
  termination
  rehire
  performance_review

  @@map("lifecycle_event_type")
}

model Employee {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  employeeNumber    String           @map("employee_number")
  firstName         String           @map("first_name")
  lastName          String           @map("last_name")
  personalInfo      Json             @default("{}") @map("personal_info")
  employmentStatus  EmploymentStatus @default(active) @map("employment_status")
  departmentId      String?          @map("department_id") @db.Uuid
  designationId     String?          @map("designation_id") @db.Uuid
  employmentTypeId  String?          @map("employment_type_id") @db.Uuid
  managerId         String?          @map("manager_id") @db.Uuid
  hireDate          DateTime         @map("hire_date") @db.Date
  probationEndDate  DateTime?        @map("probation_end_date") @db.Date
  confirmationDate  DateTime?        @map("confirmation_date") @db.Date
  workLocationId    String?          @map("work_location_id") @db.Uuid
  costCentreId      String?          @map("cost_centre_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation    Designation?    @relation(fields: [designationId], references: [id], onDelete: Restrict)
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id], onDelete: Restrict)
  manager        Employee?       @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: Restrict)
  directReports  Employee[]      @relation("EmployeeManager")
  workLocation   Location?       @relation("EmployeeWorkLocation", fields: [workLocationId], references: [id], onDelete: Restrict)
  costCentre     CostCentre?     @relation("EmployeeCostCentre", fields: [costCentreId], references: [id], onDelete: Restrict)
  documents      EmployeeDocument[]
  lifecycleEvents EmployeeLifecycleEvent[]
  attendanceRecords AttendanceRecord[]
  attendanceSyncEvents AttendanceSyncEvent[]
  rosters           Roster[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  salaryStructures  SalaryStructure[]
  payrollRuns       PayrollRun[]
  payrollAdjustments PayrollAdjustment[]
  paymentBatchItems PaymentBatchItem[]
  taxProfiles       EmployeeTaxProfile[]
  user              User?
  contractRules     EmployeeContractRule[]
  employmentContracts EmploymentContract[]
  employeeLoans       EmployeeLoan[]
  expenseClaims       ExpenseClaim[]
  timesheetEntries    TimesheetEntry[]
  timesheetSyncEvents TimesheetSyncEvent[]
  requestedJobRequisitions JobRequisition[] @relation("RequisitionRequester")
  hiredApplications JobApplication[] @relation("HiredApplication")
  interviewRoundsConducted JobApplicationInterviewRound[] @relation("InterviewInterviewer")
  holidays          Holiday[]
  employeeOnboarding EmployeeOnboarding?
  employeeOffboarding EmployeeOffboarding?
  assetAssignments    EmployeeAssetAssignment[]
  benefitEnrollments  BenefitEnrollment[]
  exitInterviewsConducted ExitInterviewRecord[] @relation("ExitInterviewInterviewer")
  exitInterviewRecords ExitInterviewRecord[]
  employeeKpiAssignments EmployeeKpiAssignment[]
  performanceReviewParticipants PerformanceReviewParticipant[]
  employeePerformanceReviews EmployeePerformanceReview[] @relation("ReviewSubject")
  managedPerformanceReviews EmployeePerformanceReview[] @relation("ReviewManager")
  performance360FeedbackGiven Performance360Feedback[] @relation("360FeedbackReviewer")
  trainingAttendances         TrainingAttendance[]
  employeeSkills              EmployeeSkill[]
  employeeCertifications      EmployeeCertification[]
  hrCasesAsSubject            HrCase[] @relation("HrCaseSubject")
  hrCasesAsReporter           HrCase[] @relation("HrCaseReporter")
  hrCasesAssigned             HrCase[] @relation("HrCaseOfficer")
  hrCaseParties               HrCaseParty[]
  engagementSurveyResponses   EngagementSurveyResponse[]
  kudosGiven                  EmployeeKudos[] @relation("KudosGiven")
  kudosReceived               EmployeeKudos[] @relation("KudosReceived")
  workplaceIncidentsReported  WorkplaceIncident[] @relation("IncidentReporter")
  workplaceIncidentParties    WorkplaceIncidentParty[]
  injuryLogEntries            InjuryLogEntry[] @relation("InjuredEmployee")
  safetyComplianceRecords     SafetyComplianceRecord[]
  safetyInspectionsConducted  SafetyInspection[] @relation("SafetyInspector")
  ownedContractorContracts    ContractorContract[] @relation("ContractOwner")
  contractorsOwned            Contractor[] @relation("ContractorOwner")

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([departmentId])
  @@index([designationId])
  @@index([employmentTypeId])
  @@index([managerId])
  @@index([workLocationId])
  @@index([costCentreId])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// §3a Employment Contracts (MODULES.md §06)
// ---------------------------------------------------------------------------

enum EmploymentContractType {
  permanent
  fixed_term
  casual
  project_based

  @@map("employment_contract_type")
}

enum EmploymentContractStatus {
  draft
  active
  terminated

  @@map("employment_contract_status")
}

enum PayFrequency {
  hourly
  weekly
  biweekly
  monthly
  annual

  @@map("pay_frequency")
}

model EmploymentContract {
  id                    String                   @id @default(uuid()) @db.Uuid
  tenantId              String                   @map("tenant_id") @db.Uuid
  companyId             String                   @map("company_id") @db.Uuid
  employeeId            String                   @map("employee_id") @db.Uuid
  contractType          EmploymentContractType   @map("contract_type")
  status                EmploymentContractStatus @default(draft)
  startDate             DateTime                 @map("start_date") @db.Date
  endDate               DateTime?                @map("end_date") @db.Date
  probationEndDate      DateTime?                @map("probation_end_date") @db.Date
  workingHoursPerWeek   Decimal?                 @map("working_hours_per_week") @db.Decimal(5, 2)
  payRate               Decimal?                 @map("pay_rate") @db.Decimal(14, 2)
  payFrequency          PayFrequency?            @map("pay_frequency")
  currency              String                   @default("AUD")
  leaveEntitlementDays  Decimal?                 @map("leave_entitlement_days") @db.Decimal(8, 2)
  overtimeRule          Json?                    @map("overtime_rule")
  noticePeriodDays      Int?                     @map("notice_period_days")
  employerNoticeDays    Int?                     @map("employer_notice_days")
  terminationConditions String?                  @map("termination_conditions")
  renewedFromId         String?                  @map("renewed_from_id") @db.Uuid
  signedAt              DateTime?                @map("signed_at")
  expiryAlertSentAt     DateTime?                @map("expiry_alert_sent_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee    Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  renewedFrom EmploymentContract?          @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals    EmploymentContract[]         @relation("ContractRenewal")
  documents   EmploymentContractDocument[]

  @@index([tenantId])
  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([endDate])
  @@map("employment_contracts")
}

model EmploymentContractDocument {
  id           String   @id @default(uuid()) @db.Uuid
  contractId   String   @map("contract_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  label        String
  fileKey      String   @map("file_key")
  originalName String   @map("original_name")
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  contract EmploymentContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([tenantId])
