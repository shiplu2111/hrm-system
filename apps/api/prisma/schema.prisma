  endDate     DateTime            @map("end_date") @db.Date
  paymentDate DateTime            @map("payment_date") @db.Date
  status      PayrollPeriodStatus @default(draft)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payrollRuns PayrollRun[]
  payrollAdjustments PayrollAdjustment[]
  paymentBatches PaymentBatch[]

  @@index([companyId])
  @@index([companyId, startDate])
  @@map("payroll_periods")
}

model PayrollRun {
  id               String           @id @default(uuid()) @db.Uuid
  payrollPeriodId  String           @map("payroll_period_id") @db.Uuid
  employeeId       String           @map("employee_id") @db.Uuid
  grossPay         Decimal          @map("gross_pay") @db.Decimal(14, 2)
  totalDeductions  Decimal          @map("total_deductions") @db.Decimal(14, 2)
  netPay           Decimal          @map("net_pay") @db.Decimal(14, 2)
  status           PayrollRunStatus @default(draft)
  finalizedAt      DateTime?        @map("finalized_at")
  locked           Boolean          @default(false)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  payrollPeriod              PayrollPeriod               @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  employee                   Employee                    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payslips                   Payslip[]
  superannuationContributions SuperannuationContribution[]
  adjustmentsAsOriginal      PayrollAdjustment[] @relation("OriginalPayrollRun")
  paymentBatchItem           PaymentBatchItem?

  @@index([payrollPeriodId])
  @@index([employeeId])
  @@index([status])
  @@map("payroll_runs")
}

enum PayrollAdjustmentStatus {
  draft
  pending
  applied
  cancelled

  @@map("payroll_adjustment_status")
}

/// Retroactive correction entry — never mutates a finalized payroll run (PAYROLL_LOGIC.md §11)
model PayrollAdjustment {
  id                     String                  @id @default(uuid()) @db.Uuid
  companyId              String                  @map("company_id") @db.Uuid
  employeeId             String                  @map("employee_id") @db.Uuid
  originalPayrollRunId   String                  @map("original_payroll_run_id") @db.Uuid
  applyToPayrollPeriodId String?                 @map("apply_to_payroll_period_id") @db.Uuid
  retroactiveFrom        DateTime                @map("retroactive_from") @db.Date
  retroactiveTo          DateTime                @map("retroactive_to") @db.Date
  reason                 String
  originalGrossPay       Decimal                 @map("original_gross_pay") @db.Decimal(14, 2)
  originalTotalDeductions Decimal                @map("original_total_deductions") @db.Decimal(14, 2)
  originalNetPay         Decimal                 @map("original_net_pay") @db.Decimal(14, 2)
  revisedGrossPay        Decimal                 @map("revised_gross_pay") @db.Decimal(14, 2)
  revisedTotalDeductions Decimal                 @map("revised_total_deductions") @db.Decimal(14, 2)
  revisedNetPay          Decimal                 @map("revised_net_pay") @db.Decimal(14, 2)
  adjustmentGrossPay     Decimal                 @map("adjustment_gross_pay") @db.Decimal(14, 2)
  adjustmentTotalDeductions Decimal              @map("adjustment_total_deductions") @db.Decimal(14, 2)
  adjustmentNetPay       Decimal                 @map("adjustment_net_pay") @db.Decimal(14, 2)
  status                 PayrollAdjustmentStatus @default(draft)
  appliedAt              DateTime?               @map("applied_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  company              Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee             Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  originalPayrollRun   PayrollRun     @relation("OriginalPayrollRun", fields: [originalPayrollRunId], references: [id], onDelete: Restrict)
  applyToPayrollPeriod PayrollPeriod? @relation(fields: [applyToPayrollPeriodId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([employeeId])
  @@index([originalPayrollRunId])
  @@index([applyToPayrollPeriodId])
  @@index([status])
  @@map("payroll_adjustments")
}

model Payslip {
  id           String   @id @default(uuid()) @db.Uuid
  payrollRunId String   @map("payroll_run_id") @db.Uuid
  fileKey      String   @map("file_key")
  generatedAt  DateTime @map("generated_at")
