enum AssetStatus {
  available
  assigned
  in_repair
  retired

  @@map("asset_status")
}

enum AssetCategory {
  laptop
  monitor
  mobile
  phone
  sim
  accessory
  id_card
  equipment

  @@map("asset_category")
}

enum AssetAssignmentStatus {
  active
  returned

  @@map("asset_assignment_status")
}

model CompanyAsset {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  name             String
  assetTag         String        @map("asset_tag")
  category         AssetCategory
  serialNumber     String?       @map("serial_number")
  purchaseDate     DateTime?     @map("purchase_date") @db.Date
  warrantyExpiryDate DateTime?   @map("warranty_expiry_date") @db.Date
  purchaseValue    Decimal?      @map("purchase_value") @db.Decimal(12, 2)
  currency         String        @default("AUD") @db.VarChar(3)
  status           AssetStatus   @default(available)
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments      EmployeeAssetAssignment[]
  offboardingTasks EmployeeOffboardingTask[]
  onboardingTasks  EmployeeOnboardingTask[]

  @@unique([companyId, assetTag])
  @@index([tenantId])
  @@index([companyId])
  @@index([status])
  @@map("company_assets")
}

model EmployeeAssetAssignment {
  id                 String                @id @default(uuid()) @db.Uuid
  assetId            String                @map("asset_id") @db.Uuid
  employeeId         String                @map("employee_id") @db.Uuid
  status             AssetAssignmentStatus @default(active)
  assignedAt         DateTime              @default(now()) @map("assigned_at")
  returnedAt         DateTime?             @map("returned_at")
  conditionOnAssign  String?               @map("condition_on_assign")
  conditionOnReturn  String?               @map("condition_on_return")
  notes              String?
  assignedByUserId   String?               @map("assigned_by_user_id") @db.Uuid
  returnedByUserId   String?               @map("returned_by_user_id") @db.Uuid
  offboardingTaskId  String?               @map("offboarding_task_id") @db.Uuid
  onboardingTaskId   String?               @map("onboarding_task_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  asset           CompanyAsset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee        Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  offboardingTask EmployeeOffboardingTask? @relation(fields: [offboardingTaskId], references: [id], onDelete: SetNull)
  onboardingTask  EmployeeOnboardingTask?  @relation(fields: [onboardingTaskId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([employeeId])
  @@index([status])
  @@index([offboardingTaskId])
  @@index([onboardingTaskId])
  @@map("employee_asset_assignments")
}

