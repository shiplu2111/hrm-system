}

enum LoanInstallmentStatus {
  scheduled
  paid
  skipped

  @@map("loan_installment_status")
}

model EmployeeLoan {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  companyId            String             @map("company_id") @db.Uuid
  employeeId           String             @map("employee_id") @db.Uuid
  referenceNumber      String             @map("reference_number")
  loanKind             EmployeeLoanKind   @map("loan_kind")
  purposeLabel         String?            @map("purpose_label")
  principalAmount      Decimal            @map("principal_amount") @db.Decimal(14, 2)
  interestRatePercent  Decimal            @default(0) @map("interest_rate_percent") @db.Decimal(8, 4)
  tenorMonths          Int                @map("tenor_months")
  monthlyInstallment   Decimal            @map("monthly_installment") @db.Decimal(14, 2)
  totalRepayable       Decimal            @map("total_repayable") @db.Decimal(14, 2)
  repaidAmount         Decimal            @default(0) @map("repaid_amount") @db.Decimal(14, 2)
  remainingBalance     Decimal            @map("remaining_balance") @db.Decimal(14, 2)
  installmentsPaid     Int                @default(0) @map("installments_paid")
  deductFromPayroll    Boolean            @default(true) @map("deduct_from_payroll")
  status               EmployeeLoanStatus @default(pending_approval)
  firstDueDate         DateTime?          @map("first_due_date") @db.Date
  disbursedAt          DateTime?          @map("disbursed_at")
  approvedAt           DateTime?          @map("approved_at")
  rejectedAt           DateTime?          @map("rejected_at")
  payComponentId       String?            @map("pay_component_id") @db.Uuid
  salaryStructureId    String?            @map("salary_structure_id") @db.Uuid
  notes                String?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payComponent    PayComponent?     @relation(fields: [payComponentId], references: [id], onDelete: SetNull)
  salaryStructure SalaryStructure?  @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  installments    LoanInstallment[]

  @@unique([companyId, referenceNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@map("employee_loans")
}

model LoanInstallment {
  id                String                @id @default(uuid()) @db.Uuid
  loanId            String                @map("loan_id") @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  installmentNumber Int                   @map("installment_number")
  dueDate           DateTime              @map("due_date") @db.Date
  principalPortion  Decimal               @map("principal_portion") @db.Decimal(14, 2)
  interestPortion   Decimal               @map("interest_portion") @db.Decimal(14, 2)
  totalDue          Decimal               @map("total_due") @db.Decimal(14, 2)
  status            LoanInstallmentStatus @default(scheduled)
  paidAt            DateTime?             @map("paid_at")
  payrollRunId      String?               @map("payroll_run_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  loan       EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payrollRun PayrollRun?  @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@unique([loanId, installmentNumber])
  @@index([loanId])
  @@index([tenantId])
  @@index([dueDate, status])
  @@index([payrollRunId])
  @@map("loan_installments")
}

