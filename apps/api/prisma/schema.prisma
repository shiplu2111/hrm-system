  updatedAt    DateTime @updatedAt @map("updated_at")

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId])
  @@index([payrollRunId])
  @@map("payslips")
}

enum PaymentBatchStatus {
  draft
  pending
  paid
  failed

  @@map("payment_batch_status")
}

enum PaymentBatchItemStatus {
  pending
  paid
  failed

  @@map("payment_batch_item_status")
}

model PaymentBatch {
  id                   String             @id @default(uuid()) @db.Uuid
  companyId            String             @map("company_id") @db.Uuid
  payrollPeriodId      String             @map("payroll_period_id") @db.Uuid
