  policyAcceptedAt   DateTime?              @map("policy_accepted_at")
  assigneeLabel      String?                @map("assignee_label")
  dueDate            DateTime?              @map("due_date") @db.Date
  status             OnboardingTaskStatus   @default(pending)
  completedAt        DateTime?              @map("completed_at")
  completedByUserId  String?                @map("completed_by_user_id") @db.Uuid
  sortOrder          Int                    @default(0) @map("sort_order")
  isRequired         Boolean                @default(true) @map("is_required")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  onboarding       EmployeeOnboarding              @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  templateItem     OnboardingChecklistTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  documentType     DocumentType?                   @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  employeeDocument EmployeeDocument?               @relation(fields: [employeeDocumentId], references: [id], onDelete: SetNull)
  companyAsset     CompanyAsset?                   @relation(fields: [companyAssetId], references: [id], onDelete: SetNull)
