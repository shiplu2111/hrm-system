}

enum ContractorPaymentBatchItemStatus {
  pending
  paid
  failed

  @@map("contractor_payment_batch_item_status")
}

/// Non-employee vendor, freelancer or consultant — not linked to salary_structures.
model Contractor {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  contractorNumber String           @map("contractor_number")
  legalName        String           @map("legal_name")
  displayName      String?          @map("display_name")
  contractorKind   ContractorKind   @default(consultant) @map("contractor_kind")
  category         String?
  contactName      String?          @map("contact_name")
  email            String?
  phone            String?
  location         String?
  taxId            String?          @map("tax_id")
  status           ContractorStatus @default(draft)
  ownerEmployeeId  String?          @map("owner_employee_id") @db.Uuid
  bankDetails      Json             @default("{}") @map("bank_details")
  notes            String?          @db.Text
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company   Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  owner     Employee?            @relation("ContractorOwner", fields: [ownerEmployeeId], references: [id], onDelete: SetNull)
  contracts ContractorContract[]
  invoices  ContractorInvoice[]
  paymentBatchItems ContractorPaymentBatchItem[]

  @@unique([companyId, contractorNumber])
  @@index([tenantId])
  @@index([companyId, status])
  @@map("contractors")
}

/// Contract-based payment terms for a contractor.
model ContractorContract {
  id                String                     @id @default(uuid()) @db.Uuid
  tenantId          String                     @map("tenant_id") @db.Uuid
  companyId         String                     @map("company_id") @db.Uuid
  contractorId      String                     @map("contractor_id") @db.Uuid
  contractNumber    String                     @map("contract_number")
  title             String
  scopeDescription  String?                    @map("scope_description") @db.Text
  status            ContractorContractStatus   @default(draft)
  startDate         DateTime                   @map("start_date") @db.Date
  endDate           DateTime                   @map("end_date") @db.Date
  annualValue       Decimal?                   @map("annual_value") @db.Decimal(14, 2)
  fixedFeeAmount    Decimal?                   @map("fixed_fee_amount") @db.Decimal(14, 2)
  hourlyRate        Decimal?                   @map("hourly_rate") @db.Decimal(14, 2)
  currency          String                     @default("AUD") @db.VarChar(3)
  paymentStructure  ContractorPaymentStructure @default(fixed_project_fee) @map("payment_structure")
  paymentTerms      ContractorPaymentTerms     @default(net_30) @map("payment_terms")
  billingFrequency  ContractorBillingFrequency @default(monthly) @map("billing_frequency")
  autoRenewal       Boolean                    @default(false) @map("auto_renewal")
  noticePeriodDays  Int                        @default(30) @map("notice_period_days")
  ownerEmployeeId   String?                    @map("owner_employee_id") @db.Uuid
  createdByUserId   String                     @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contractor Contractor          @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  owner      Employee?           @relation("ContractOwner", fields: [ownerEmployeeId], references: [id], onDelete: SetNull)
  invoices   ContractorInvoice[]
  milestones ContractorContractMilestone[]

  @@unique([companyId, contractNumber])
  @@index([tenantId])
  @@index([companyId, status])
  @@index([contractorId])
  @@index([companyId, endDate])
  @@map("contractor_contracts")
}

model ContractorContractMilestone {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  companyId   String                    @map("company_id") @db.Uuid
  contractId  String                    @map("contract_id") @db.Uuid
  title       String
