model EngagementSurveyQuestion {
  id           String                 @id @default(uuid()) @db.Uuid
  surveyId     String                 @map("survey_id") @db.Uuid
  sortOrder    Int                    @map("sort_order")
  questionType EngagementQuestionType @map("question_type")
  prompt       String
  isRequired   Boolean                @default(false) @map("is_required")
  /// Multiple-choice option labels.
  options      Json?
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  survey  EngagementSurvey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers EngagementSurveyAnswer[]

  @@unique([surveyId, sortOrder])
  @@index([surveyId])
  @@map("engagement_survey_questions")
}

model EngagementSurveyResponse {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  surveyId            String   @map("survey_id") @db.Uuid
  /// One-way hash for anonymous duplicate prevention (employeeId + surveyId).
  responseFingerprint String?  @map("response_fingerprint")
  /// Populated only when the survey is not anonymous.
  employeeId          String?  @map("employee_id") @db.Uuid
  submittedAt         DateTime @default(now()) @map("submitted_at")
  createdAt           DateTime @default(now()) @map("created_at")

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  survey   EngagementSurvey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employee Employee?                @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  answers  EngagementSurveyAnswer[]

  @@unique([surveyId, responseFingerprint])
  @@unique([surveyId, employeeId])
  @@index([tenantId])
  @@index([surveyId])
  @@map("engagement_survey_responses")
}

model EngagementSurveyAnswer {
  id             String  @id @default(uuid()) @db.Uuid
  responseId     String  @map("response_id") @db.Uuid
  questionId     String  @map("question_id") @db.Uuid
  textValue      String? @map("text_value") @db.Text
  numericValue   Int?    @map("numeric_value")
  selectedOption String? @map("selected_option")
  createdAt      DateTime @default(now()) @map("created_at")

  response EngagementSurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question EngagementSurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([questionId])
  @@map("engagement_survey_answers")
}

