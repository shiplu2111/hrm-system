  @@index([companyId])
  @@map("leave_types")
}

model LeavePolicy {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @map("company_id") @db.Uuid
  leaveTypeId          String              @map("leave_type_id") @db.Uuid
  entitlementDays      Decimal             @map("entitlement_days") @db.Decimal(8, 2)
  accrualType          LeaveAccrualType    @map("accrual_type")
  carryForwardMax      Decimal?            @map("carry_forward_max") @db.Decimal(8, 2)
  expiryMonths         Int?                @map("expiry_months")
  encashmentAllowed    Boolean             @default(false) @map("encashment_allowed")
  probationRestricted  Boolean             @default(true) @map("probation_restricted")
  allowNegativeBalance Boolean             @default(false) @map("allow_negative_balance")
  negativeBalanceCap   Decimal?            @map("negative_balance_cap") @db.Decimal(8, 2)
  halfDayAllowed       Boolean             @default(true) @map("half_day_allowed")
  deductPublicHolidays Boolean             @default(false) @map("deduct_public_holidays")
  approvalSteps        Json                @default("[{\"roleName\":\"Manager\"},{\"roleName\":\"HR Admin\"}]") @map("approval_steps")
  yearlyAccrualAnchor  YearlyAccrualAnchor @default(financial_year) @map("yearly_accrual_anchor")
  effectiveFrom        DateTime            @map("effective_from") @db.Date
  effectiveTo          DateTime?           @map("effective_to") @db.Date
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([leaveTypeId])
  @@index([companyId, leaveTypeId, effectiveFrom])
  @@map("leave_policies")
}

model LeaveBalance {
  id                    String    @id @default(uuid()) @db.Uuid
  employeeId            String    @map("employee_id") @db.Uuid
  leaveTypeId           String    @map("leave_type_id") @db.Uuid
  balanceDays           Decimal   @map("balance_days") @db.Decimal(8, 2)
