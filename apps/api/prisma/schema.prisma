enum OffboardingTaskCategory {
  clearance
  asset_return
  access_revocation
  exit_process
  final_settlement

  @@map("offboarding_task_category")
}

enum OffboardingTaskType {
  clearance
  asset_return
  access_revocation
  exit_interview
  final_settlement
  manual_task

  @@map("offboarding_task_type")
}

enum OffboardingStatus {
  in_progress
  completed
  cancelled

  @@map("offboarding_status")
}

enum OffboardingTaskStatus {
  pending
  completed
  skipped

  @@map("offboarding_task_status")
}

model OffboardingChecklistTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company                           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items       OffboardingChecklistTemplateItem[]
  offboardings EmployeeOffboarding[]

  @@unique([companyId, name])
  @@index([tenantId])
  @@index([companyId])
  @@map("offboarding_checklist_templates")
}

model OffboardingChecklistTemplateItem {
  id              String                  @id @default(uuid()) @db.Uuid
  templateId      String                  @map("template_id") @db.Uuid
  title           String
  description     String?
  category        OffboardingTaskCategory
  taskType        OffboardingTaskType     @map("task_type")
  assetCategory   AssetCategory?          @map("asset_category")
  assigneeLabel   String?                 @map("assignee_label")
  dueDaysOffset   Int?                    @map("due_days_offset")
  sortOrder       Int                     @default(0) @map("sort_order")
  isRequired      Boolean                 @default(true) @map("is_required")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  template OffboardingChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks    EmployeeOffboardingTask[]

  @@index([templateId])
  @@map("offboarding_checklist_template_items")
}

model EmployeeOffboarding {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  employeeId      String            @unique @map("employee_id") @db.Uuid
  templateId      String?           @map("template_id") @db.Uuid
  status          OffboardingStatus @default(in_progress)
  lastWorkingDate DateTime?         @map("last_working_date") @db.Date
  startedAt       DateTime          @default(now()) @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  accessRevokedAt DateTime?         @map("access_revoked_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant        Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee      Employee                    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  template      OffboardingChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tasks         EmployeeOffboardingTask[]
  exitInterview ExitInterviewRecord?

  @@index([tenantId])
  @@index([companyId])
  @@index([status])
  @@map("employee_offboardings")
}

model EmployeeOffboardingTask {
  id                  String                  @id @default(uuid()) @db.Uuid
  offboardingId       String                  @map("offboarding_id") @db.Uuid
  templateItemId      String?                 @map("template_item_id") @db.Uuid
  title               String
  description         String?
  category            OffboardingTaskCategory
  taskType            OffboardingTaskType     @map("task_type")
  assetCategory       AssetCategory?          @map("asset_category")
  companyAssetId      String?                 @map("company_asset_id") @db.Uuid
  payrollAdjustmentId String?                 @map("payroll_adjustment_id") @db.Uuid
  assigneeLabel       String?                 @map("assignee_label")
  dueDate             DateTime?               @map("due_date") @db.Date
  status              OffboardingTaskStatus   @default(pending)
  completedAt         DateTime?               @map("completed_at")
  completedByUserId   String?                 @map("completed_by_user_id") @db.Uuid
  sortOrder           Int                     @default(0) @map("sort_order")
  isRequired          Boolean                 @default(true) @map("is_required")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  offboarding       EmployeeOffboarding              @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
  templateItem      OffboardingChecklistTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  companyAsset      CompanyAsset?                    @relation(fields: [companyAssetId], references: [id], onDelete: SetNull)
  payrollAdjustment PayrollAdjustment?               @relation(fields: [payrollAdjustmentId], references: [id], onDelete: SetNull)
  assetReturns      EmployeeAssetAssignment[]

  @@index([offboardingId])
  @@index([companyAssetId])
  @@index([payrollAdjustmentId])
  @@map("employee_offboarding_tasks")
}

model ExitInterviewRecord {
  id                     String    @id @default(uuid()) @db.Uuid
  offboardingId          String    @unique @map("offboarding_id") @db.Uuid
  employeeId             String    @map("employee_id") @db.Uuid
  scheduledAt            DateTime? @map("scheduled_at")
  conductedAt            DateTime? @map("conducted_at")
  interviewerEmployeeId  String?   @map("interviewer_employee_id") @db.Uuid
  feedback               String?
  reasonForLeaving       String?   @map("reason_for_leaving")
  wouldRehire            Boolean?  @map("would_rehire")
  rating                 Int?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  offboarding  EmployeeOffboarding @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  interviewer  Employee?           @relation("ExitInterviewInterviewer", fields: [interviewerEmployeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([interviewerEmployeeId])
  @@map("exit_interview_records")
}

