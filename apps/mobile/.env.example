# Optional override. If unset or localhost, Android emulator auto-uses 10.0.2.2:3000.
# Physical device: set to http://YOUR_PC_LAN_IP:3000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Push (Firebase FCM): add google-services.json to apps/mobile/ for Android production builds.
# Native device tokens are registered with the API after the employee grants notification permission.
