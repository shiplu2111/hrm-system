# CMSN-HR Marketing Website Environment
# Environment mode: development (staging) | production
NEXT_PUBLIC_APP_ENV=development
SITE_IS_STAGING=true
NEXT_PUBLIC_SITE_URL=http://localhost:5180
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:5174
NEXT_PUBLIC_PLATFORM_URL=http://localhost:5176
NEXT_PUBLIC_CACHE_REVALIDATE_SECONDS=10
# On-demand ISR/CDN cache purge secret (set via secrets manager, never commit real value)
REVALIDATE_SECRET=

# Privacy-first analytics configuration
# Mode: "consent" (strictly gated behind cookie banner opt-in) | "cookieless" (cookie-free where law allows, still honors opt-out)
NEXT_PUBLIC_ANALYTICS_MODE=consent
NEXT_PUBLIC_ANALYTICS_PROVIDER=first-party
NEXT_PUBLIC_ANALYTICS_COOKIELESS=true
# Optional Plausible settings (cookieless by design):
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=cmsn-hr.example
# NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.manual.js
# NEXT_PUBLIC_MARKETING_SCRIPT_URL=
# Optional server-side forwarder host (e.g. https://plausible.io)
# PLAUSIBLE_API_HOST=
