# Marketing website (Next.js). Copy to apps/web/.env.local — Next reads env files from this folder.

# Public URL of this site (canonical links, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:5173
# Admin / employee portal that "Sign in" links to
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:5174

# Order and contact form delivery. Without SMTP_HOST, development logs submissions to the
# server console and production rejects them so enquiries are never silently lost.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexus HR <no-reply@nexushr.app>"
# Inbox that receives new orders and sales enquiries (defaults to the sales address in src/lib/site.ts)
SALES_INBOX_EMAIL=
